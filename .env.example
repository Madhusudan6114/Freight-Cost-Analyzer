# FreightTiger Shipping Cost Anomaly Detector — Configuration

# Groq API key (free at https://console.groq.com/keys)
GROQ_API_KEY=your-api-key-here

# Anomaly detection thresholds (percentage above baseline to flag)
HISTORY_THRESHOLD=15.0
PEER_THRESHOLD=15.0

# LLM settings
LLM_TEMPERATURE=0
LLM_MODEL=llama-3.3-70b-versatile
